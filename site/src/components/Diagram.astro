---
// A hand-drawn diagram in the README's style, in the theme the page is showing.
interface Props {
  name: string;
  alt: string;
}
const { name, alt } = Astro.props;
const base = import.meta.env.BASE_URL;
// Their drawn sizes, so the page doesn't jump as they load.
const height = { how: 600, reach: 600, trap: 560, fixes: 560 }[name] ?? 600;
---

<figure class="diagram">
  <img class="for-light" src={`${base}diagrams/${name}.png`} alt={alt} width="1400" height={height} loading="lazy" decoding="async" />
  <img class="for-dark" src={`${base}diagrams/${name}-dark.png`} alt="" aria-hidden="true" width="1400" height={height} loading="lazy" decoding="async" />
</figure>
