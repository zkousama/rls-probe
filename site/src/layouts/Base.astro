---
// Every page's frame: metadata, header and footer, in the inspection design.
import "../styles/global.css";
import pkg from "../../../package.json";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const repo = "https://github.com/zkousama/rls-probe";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fbfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121a33" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body class="min-h-screen">
    <header class="mx-auto flex max-w-6xl items-center justify-between px-5 py-6 sm:px-8">
      <a href={base} class="text-xl font-extrabold text-ink [font-stretch:125%]">rls-probe</a>
      <nav class="flex items-center gap-6 text-[0.95rem] text-muted">
        <a href={`${base}#how`} class="hidden hover:text-text sm:inline">How it works</a>
        <a href={`${base}#guides`} class="hidden hover:text-text sm:inline">Guides</a>
        <a href={repo} class="font-semibold text-text underline decoration-rule decoration-2 underline-offset-4 hover:decoration-ink">Source on GitHub</a>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-5 pb-20 sm:px-8">
      <slot />

      <footer class="mt-24 border-t border-rule pt-6 text-[0.9rem] text-muted">
        <p>rls-probe {pkg.version}, open source under the MIT license. <a class="underline underline-offset-4" href={repo}>Source on GitHub</a>, <a class="underline underline-offset-4" href="https://www.npmjs.com/package/rls-probe">package on npm</a>.</p>
        <p class="mt-1">Made by Ousama Ajebbar. Want your app checked and fixed by a person? <a class="underline underline-offset-4" href="https://www.upwork.com/freelancers/~012952805fd983991e">Hire me on Upwork</a>.</p>
        <p class="mt-1">Not affiliated with Supabase, Lovable or Bolt.</p>
      </footer>
    </main>
  </body>
</html>
