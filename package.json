{
  "name": "rls-probe",
  "version": "0.3.0",
  "description": "Finds what a visitor, or another signed-in user, can read and change in a Supabase app, and which grants are safe after Supabase's 2026 grants change, by running its migrations offline",
  "keywords": [
    "supabase",
    "row-level-security",
    "rls",
    "postgres",
    "postgresql",
    "security",
    "audit",
    "lovable",
    "bolt",
    "vibe-coding",
    "grants",
    "42501",
    "pglite",
    "cli"
  ],
  "homepage": "https://github.com/zkousama/rls-probe#readme",
  "bugs": {
    "url": "https://github.com/zkousama/rls-probe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zkousama/rls-probe.git"
  },
  "license": "MIT",
  "author": "Ousama Ajebbar",
  "type": "module",
  "bin": {
    "rls-probe": "src/cli.js"
  },
  "files": [
    "src",
    "snapshot",
    "action.yml"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepack": "node scripts/build-snapshot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
