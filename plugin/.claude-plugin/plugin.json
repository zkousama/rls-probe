{
  "name": "rls-probe",
  "version": "0.10.4",
  "description": "Checks a Supabase app's row-level security, grants and leaked keys by running its migrations offline, and tells you what to fix.",
  "author": {
    "name": "Ousama Ajebbar"
  },
  "homepage": "https://github.com/zkousama/rls-probe",
  "repository": "https://github.com/zkousama/rls-probe",
  "license": "MIT",
  "keywords": [
    "supabase",
    "security",
    "rls",
    "row-level-security",
    "lovable",
    "bolt"
  ],
  "mcpServers": {
    "probe": {
      "command": "npx",
      "args": [
        "-y",
        "rls-probe@0.10.4",
        "mcp"
      ]
    }
  }
}
